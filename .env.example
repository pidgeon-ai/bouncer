# ── Pidgeon ─────────────────────────────────────────────────────────────
# pgn_test_… in development and CI: nothing ever leaves Pidgeon.
# Production needs a pgn_live_ key that can create pods and addresses.
PIDGEON_API_KEY=pgn_test_replace_me
# Shown once when you create the webhook (see README → Setup).
PIDGEON_WEBHOOK_SECRET=
# PIDGEON_BASE_URL=https://pidgeon.ai/api/v1

# ── Bouncer ─────────────────────────────────────────────────────────────
BOUNCER_SITE_URL=http://localhost:3100
BOUNCER_FRONT_DOOR=bouncer@pidgeon.ai
BOUNCER_PERSONAL_DOMAIN=bouncer.pidgeon.email
# Signs stop/report links. Any long random string: openssl rand -base64 32
BOUNCER_LINK_SECRET=
# Vercel Cron sends this as a bearer token.
CRON_SECRET=

# Caps (defaults shown)
# BOUNCER_DAILY_CAP_PER_USER=25
# BOUNCER_DAILY_CAP_GLOBAL=2000
# BOUNCER_AI_DAILY_CALL_CAP=5000
# BOUNCER_RETENTION_DAYS=30

# Test mode only (ignored with a live key):
# test inbound mail has no SPF/DKIM/DMARC, so trust messages marked test.
BOUNCER_TRUST_TEST_AUTH=1
# Test keys can't create addresses: personal addresses come from this pool.
BOUNCER_TEST_ADDRESS_POOL=

# ── Model ───────────────────────────────────────────────────────────────
# Without a key, Bouncer uses timid keyword rules instead of a model.
# On Vercel, OIDC authenticates the AI Gateway and no key is needed.
# AI_GATEWAY_API_KEY=
# BOUNCER_AI_MODEL=anthropic/claude-haiku-5.5

# ── Database ────────────────────────────────────────────────────────────
# Any Postgres. Unset: PGlite (in-process Postgres) under .data/
# DATABASE_URL=postgres://…
