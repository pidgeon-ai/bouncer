# ── Who Bouncer works for ───────────────────────────────────────────────
# Bouncer's own address on Pidgeon. You forward cold email here; declines go out from here.
BOUNCER_ADDRESS=bouncer-yourname@pidgeon.email
# You. Only mail from this address that passes SPF/DKIM/DMARC is ever acted on.
BOUNCER_OWNER_EMAIL=you@example.com
# Your first name, as declines say it: "Sam asked me to reply…"
BOUNCER_OWNER_NAME=Sam
# 3 = ask me first (default): nothing goes to anyone until you reply YES.
# 1 = polite no, 2 = not now, try next quarter: both sent without asking.
BOUNCER_STYLE=3

# ── Pidgeon ─────────────────────────────────────────────────────────────
# A key with access "send" on BOUNCER_ADDRESS only. pgn_test_… for trying it out: nothing leaves Pidgeon.
PIDGEON_API_KEY=
# Shown once when you register the webhook (README → Quickstart).
PIDGEON_WEBHOOK_SECRET=

# ── This deployment ─────────────────────────────────────────────────────
# Where Bouncer is reachable: the "never hear from me again" link in every decline points here.
BOUNCER_SITE_URL=http://localhost:3100
# Signs that link. Any long random string: openssl rand -base64 32
BOUNCER_LINK_SECRET=
# The crons send this as a bearer token (Vercel does it for you). openssl rand -base64 32
CRON_SECRET=

# ── Database ────────────────────────────────────────────────────────────
# Any Postgres. Unset locally: PGlite (Postgres in-process) under .data/
# DATABASE_URL=postgres://…

# ── Model ───────────────────────────────────────────────────────────────
# Without a key, Bouncer uses timid keyword rules instead of a model, so it asks you more.
# On Vercel, OIDC authenticates the AI Gateway and no key is needed.
# AI_GATEWAY_API_KEY=
# BOUNCER_AI_MODEL=anthropic/claude-haiku-5.5

# ── Limits (defaults shown) ─────────────────────────────────────────────
# BOUNCER_DAILY_CAP=25
# BOUNCER_AI_DAILY_CALL_CAP=500
# BOUNCER_RETENTION_DAYS=30

# Test mode only (ignored with a live key): test mail carries no SPF/DKIM/DMARC results.
# BOUNCER_TRUST_TEST_AUTH=1
